{
  "name": "memory-game",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "version:web": "node scripts/generate-build-version.js",
    "export:web": "node scripts/generate-build-version.js && expo export --platform web --output-dir dist-web && node scripts/inject-pwa.js dist-web",
    "deploy:pages": "node scripts/deploy-pages.js",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "private": true
}
